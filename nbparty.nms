@namespace nbparty
    # Persistent Objects (Created on __init__)
    Game currentGame
    Stage[] stages
    Stage[] evil_stages
    Stage neutral_stage
    relative Int deaths
    relative Int stages_passed
    relative Int wins

    # setup functions (manually edit before running)
    __init__()
    initStages()
    initEvilStages()
    initNeutralStage()
    initGame()

    # purely for reference, death region needs to be setup by admin
    initAreas()

    # interact scripts
    join(Block block, Player player)
    start(Block block, Player player)
    evil_mode(Block block, Player player)
    stats(Block block, Player player)
    
    # admin room
    end(Block block, Player player)

    # interact functions (interact script implementations)
    joinGame(Block block, Player player)
    startGame(Block block, Player player)
    evil_mode_toggle(Block block, Player player)
    displayStats(Block block, Player player)

    # admin room
    endGame(Block block, Player player)

    # area scripts
    deathRegionArea(Player player)

    # area functions
    deathRegionImplementation(Player player)

    @class Stage
        # x1, z1 will be on NW side
        Int x1
        Int z1
        Int x2
        Int z2
        Int y
        String stage_name
        String creator_names

        # used_blocks built from line of blocks physically placed in world next to stage on the (x1 - 1) row spanning z1 to z2
        String[] used_blocks

        # randomization is done in Stage and not Game, block chosen here
        String chosen_block

        # Default constructor
        Stage(Int x1, Int z1, Int x2, Int z2, Int y)
        Stage(Int x1, Int z1, Int x2, Int z2, Int y, String stage_name, String creator_names)
        
        # Sets chosen_block to random block in used_blocks
        chooseRandomBlock()
    @endclass

    @class Game
        # constructor variables 
        # First corner (used for /clone command)
        Int x
        Int y
        Int z
        # opposite end of playable area on SE corner (include height of playable area)
        Int xend
        Int yend
        Int zend

        # number of blocks from stage height, to bottom of where the player can fall
        Int death_area_height

        Stage[] stages
        Stage[] evil_stages
        Stage neutral_stage

        # text displays 
        Block[] join_signs
        Entity[] text_displays

        # game variables
        String[] players
        # current randomly selected stage
        Stage current_stage
        # round # 
        Int round
        # bool to prevent players from starting multiple games
        Boolean game_active
        # start_game_check & times_start_pressed used for start cancel logic in beginCountdown()
        Boolean start_game_check
        Int times_start_pressed

        Boolean evil_mode
        Boolean evil_round

        # Default constructor
        Game(Int x, Int y, Int z, Int xend, Int yend, Int zend, Int death_area_height, Stage[] stages, Stage[] evil_stages, Stage neutral_stage)

        # text display 
        # checks to see if join sign exists in list of join signs, then if not, kills existing text displays there, and creates a new one (then adds entity to list)
        addTextDisplayToListFromJoinSign(Block block)
        # takes current player list then changes all text display data (in the list) to have the list of players
        updatePlayerListDisplays()
        # helper function for updatePlayerListDisplays()
        String playerListToTextDisplay()

        # Player helper functions
        # messages all players using distance=..64 centered at this.x, this.y, this.z. This messages even spectators EDIT TO BE BETTER
        messageAllPlayers(String message)
        # messages players only within the bounds of the game box 
        messagePlayersOnStage(String message)
        # this uses players in player list only, if they get out then they can't hear anymore 
        playSoundToAllPlayers(String sound, String volume, String pitch)
        # only within bounds of game box
        playSoundToPlayersOnStage(String sound, String volume, String pitch)
        # for players in player list, changes their hotbar to a certain block
        setAllPlayerHotbars(String block)
        # sets 1 player's hotbar to a certain block
        setPlayerHotbar(String player_name, String block)
        # increments player death stat, removes them from player list, should also handle clearing their inventory and other reset functions
        eliminatePlayer(String player_name)
        # helper function to determine if player is on top of the stage (excludes the falling area)
        Boolean playerOnStage(String player_name)
        # helper function to determine if player is in playable area, including the falling area
        Boolean playerInPlayableArea(String player_name)
        # called when new stage added. if player isn't directly on stage (mainly trying to remove those who log out or teleport away, counts as a death called eliminatePlayer() on them)
        removePlayersOutsideOfPlayArea()

        # handles main game loop and calls literally every other function if debugging or trying to figure out how my terrible code works start here
        startGame()

        # startGame() functions
        # checks if start sign cancelled, and if not goes through with the countdown then returns control back to startGame()
        Boolean beginCountdown()
        # randomly spread players across stage
        teleportPlayersToStage()
        # set stage to neutral_stage
        resetStage()
        # randomly sets flag evil_round to true or false. This flag is checked in newRandomStage()
        determineEvilRound()
        # sets play area to a random stage (if evil round chooses evil stage)
        newRandomStage()
        # sends a message in chat using the variables stage_name and creator_names from stage object
        displayStageNameAndCreator()
        # master control on difficulty scaling called by waitForDisappearingBlock() TODO CHANGE FROM 0.25 SECOND INTERVALS TO 1t INTERVALS
        Int getDelayTimeFromRound()
        # TODO quarter seconds -> ticks & maybe make this just a helper function to convert seconds to ticks then have the message sent be in startGame
        informPlayersOfRoundTime()
        # chooses random block from stage and sets player hotbars to it
        chooseRandomBlock()
        # /clone & /fill to remove every block type except 1 chosen
        removeAllBlocksExceptChosen()
        # called by eliminatePlayer, checks for winner, and if there is a winner the game is ended. updates player stat
        checkForWinner(String player_name)
        # update player stat stages passed
        countStagesPassed()
        endGame()

        # Time player has after stage is loaded to walk around and look at it. TODO add boss bar for this section!
        waitForBlock()
        # waits time specified by getDelayTimeFromRound (the time to react after block chosen before stage falls) TODO change from quarter seconds to ticks & add boss bar
        waitForDisappearingBlock()
        # after blocks disappear there's a little gap when they're gone and this gives people time to fall if they failed. TODO: add bossbar
        waitAfterBlocksDisappeared()
        # neutral stage loaded, waiting. TODO: add bossbar
        waitForRoundToStart()

    @endclass

@endnamespace
