@namespace nbparty
    Game currentGame
    Stage[] stages
    Stage neutral_stage

    # setup functions (manually edit before running)
    __init__()
    initStages()
    initNeutralStage()
    initGame()

    # interact scripts
    join(Player player)
    start(Player player)

    # interact functions (interact script implementations)
    joinGame(Player player)
    startGame(Player player)

    @class Stage
        # x1, z1 will be on NW side
        Int x1
        Int z1
        Int x2
        Int z2
        Int y

        # used_blocks created in constructor, on a line in west side of stage, on the north side, all blocks used in the stage are placed
        # at coordinates (x1 - 1) and looping over z values until hitting air
        String[] used_blocks

        # the block that stays when timer runs down
        String chosen_block

        Stage(Int x1, Int z1, Int x2, Int z2, Int y)
        
        # chooses and reutrns a random block from the stage
        String chooseRandomBlock()

    @endclass

    @class Game
        # constructor variables 
        # The coordinate used for the clone command
        Int x
        Int y
        Int z
        # list of all possible stages
        Stage[] stages
        # default neutral stage to return game to
        Stage neutral_stage

        # game variables
        String[] players
        # needed for chooseRandomBlock() every stage has different blocks
        Stage current_stage
        # when a stage is cloned onto the main stage, need to loop over every block to get a Block list to be able to remove them
        # I was thinking of not having the blocks disappear and maybe they just turn into a death block but it's more fun to have the blocks removed and the player fall into lava
        Block[] current_stage_blocks
        Int round
        # time players have after block is chosen to get to block
        Float running_time
        Boolean game_active
        Boolean start_game_check
        Int times_start_pressed

        Game(Int x, Int y, Int z, Stage[] stages, Stage neutral_stage)

        messageAllPlayers(String message)
        playSoundToAllPlayers(String sound, String volume, String pitch)

        # returns true if start not cancelled, false otherwise
        Boolean beginCountdown()

        # clones neutral stage over main stage
        resetStage()
        # chooses a random stage from list then clones it to the play area
        newRandomStage()

        # after players have been added this starts the game (checks if game is already running before starting)
        # game loop
        # game loads neutral stage
        # random stage added
        # countdown at start
        # color immediately chosen (maybe walls on the side that show the block ? definitely put it in player hotbar)
        # wait for running_time time (have indicator somewhere on player screen)
        # remove all blocks except chosen block
        # wait like 3 seconds 
        # 
        # loop:
        # update round #
        # random stage added 
        # wait 5 seconds maybe for players to run around on new stage
        # choose random block from stage
        # wait for running_time time
        # remove all blocks exception chosen block
        # wait 3 seconds
        # 
        # maybe time decrease every 5 rounds ?
        # in original game people die on the border from 1.5 to 1 second
        # decreases in increments of 0.5
        # just make stage 99x99 to stay within list limit
        # start at 5 seconds to choose? changing scaling later is easy
        # game should become impossible and go until only 1 player is left
        # constantly polling for player death status might be laggy but would need to do so near the end to see who really won
        # otherwise too many ties
        startGame()

        # triggered in startGame when game ends, resets everything to default
        endGame()

    @endclass


@endnamespace