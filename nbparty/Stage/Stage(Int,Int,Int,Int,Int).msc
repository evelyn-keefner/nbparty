# constructor Stage(Int x1, Int z1, Int x2, Int z2, Int y)
@fast

@var this.x1 = x1
@var this.z1 = z1
@var this.x2 = x2
@var this.z2 = z2
@var this.y = y

@define Block currentBlock
@var this.used_blocks = String[]

@for Int i in list::range(0, (this.z2 - this.z1) + 1)
    @var currentBlock = Block((this.x1 - 1), this.y, (this.z1 + i), "theta")
    @if (!currentBlock.isEmpty())
        @var this.used_blocks.append(currentBlock.getBlockType())
    @fi 
@done

# @player [nbparty] listing blocks in used_blocks
# @for String used_block in this.used_blocks
    # @player Used block: {{used_block}}
# @done