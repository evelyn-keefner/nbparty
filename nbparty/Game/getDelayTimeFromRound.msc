# method Int getDelayTimeFromRound()
# returns how many 5t intervals to wait. 0.25 seconds

# ok i know if statements are evil but i want the control over every round and exact timing changes its ok pats
# thanks goomy
@if (this.round >= 0 && this.round <= 3)
    # 5 seconds
    @return 20
@elseif (this.round >= 4 && this.round <= 6)
    # 4 seconds
    @return 16
@elseif (this.round >= 7 && this.round <= 9)
    # 3 seconds
    @return 12
@elseif (this.round >= 10 && this.round <= 12)
    # 2.5 seconds
    @return 10
@elseif (this.round >= 13 && this.round <= 15)
    # 2 seconds
    @return 8
@elseif (this.round >= 16 && this.round <= 20)
    # 1.5 seconds
    @return 6
@elseif (this.round >= 21 && this.round <= 25)
    # 1 seconds
    @return 4
@elseif (this.round >= 26 && this.round <= 1000)
    @return 2
@else
    # MAXIMUM ROUND FOR THIS ITERATION IS: 1000
    @return -1
@fi

