@fast
@if (!this.beginCountdown())
    @if (this.times_start_pressed % 2 != 0)
        @var this.playSoundToAllPlayers("minecraft:entity.villager.hurt", "1.0", "1.27")
        @var this.messageAllPlayers("[Not Block Party] Start cancelled!")
    @fi
    @return
@fi

@var this.playSoundToAllPlayers("minecraft:entity.experience_orb.pickup", "1.0", "1.0")
@var this.messageAllPlayers("[Not Block Party] Start!")
@var this.teleportPlayersToStage()

@var this.game_active = true
@var this.normal_round = false
@var this.challenge_round = false
@var this.evil_round = false


# in theory last round never gets reached
@for Int i in list::range(1, 1000)
    # this is how loop is broken whenever game is ended by the last player being eliminated
    @if !this.game_active
        @var this.endGame()
        @return
    @fi
    # WAITING PERIOD BEFORE ROUND STARTS
    @var this.setAllPlayerHotbars("minecraft:air")
    @var this.resetStage()
    @var this.waitForRoundToStart()

    @if !this.game_active
        @var this.endGame()
        @return
    @fi
    # ROUND START PERIOD
    # check if players are still in the game (if they are logged out)
    @var this.removePlayersOutsideOfPlayArea()
    # update round #
    @var this.round += 1
    # update players about how long they will have to run to block 
    @var this.messagePlayersOnStage("[Not Block Party] Round {{this.round}}: {{this.ticksToSeconds(this.getDelayTimeFromRound())}} seconds")
    # chooses new random stage, pastes it to main area, and adds blocks in stage to a Block[] list
    @var this.determineRoundType()
    @var this.newRandomStage()
    @var this.displayStageNameAndCreator()
    # time you get to run around on the random stage before getting a block
    @var this.waitForBlock()

    @if !this.game_active
        @var this.endGame()
        @return
    @fi
    # REACTION PERIOD
    # choose random block and set player hotbar
    @var this.chooseRandomBlock()
    @var this.playSoundToPlayersOnStage("minecraft:entity.experience_orb.pickup", "1.0", "1.0")
    @var this.playSoundToPlayersOnStage("minecraft:block.note_block.bell", "1.0", "1.0")
    # changes based on round time, there was an earlier check that should end game early if on a theoretically impossible round
    @var this.waitForDisappearingBlock()

    @if !this.game_active
        @var this.endGame()
        @return
    @fi
    # WAITING PERIOD TO ALLOW PLAYER DEATHS
    @var this.removeAllBlocksExceptChosen()
    @var this.playSoundToPlayersOnStage("minecraft:entity.zombie.infect", "1.0", "1.0")
    @var this.playSoundToPlayersOnStage("minecraft:entity.zombie.destroy_egg", "1.0", "1.0")
    @var this.waitAfterBlocksDisappeared()

    @var this.countStagesPassed()
@done

@var this.messageAllPlayers("The party is over now.")
@var this.endGame()
@return
