# method informPlayersOfRoundTime
@fast

@define Float roundTimeInSeconds = 0.0
@define Int delayTimeInNumberOfQuarterSeconds = this.getDelayTimeFromRound()

@for Int i in list::range(0, delayTimeInNumberOfQuarterSeconds)
    @var roundTimeInSeconds += 0.25
@done

@var this.messagePlayersOnStage("[Not Block Party] Round {{this.round}}: {{roundTimeInSeconds}} seconds")