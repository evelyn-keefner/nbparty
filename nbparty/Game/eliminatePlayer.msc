@fast

@if this.players.contains(player_name)
    @var this.messagePlayersOnStage("&z{{player_name}} fell!")
    @var nbparty::deaths[Player(player_name)] += 1
    @define Int removeIndex = this.players.find(player_name)
    @for Int i in list::range(0, 9)
    @bypass /item replace entity {{player_name}} hotbar.{{i}} with air
    @done

    @var this.players.remove(removeIndex)
@fi
