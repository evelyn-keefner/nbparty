# method setupBossbar(String name, String color, Int max_time)
@fast 

@for String player_name in this.players
    @define String id = "nbparty" + Player(player_name).getUniqueId()
    @bypass /bossbar remove {{id}} 
    @bypass /bossbar add {{id}} {{slytools::convertTextToTellraw(name)}}
    @bypass /bossbar set {{id}} max {{max_time}}
    @if (color != "white" && color != "")
        @bypass /bossbar set {{id}} color {{color}}
    @fi
    # @bypass /bossbar set nbparty players @a[x={{this.x}},y={{this.y - this.death_area_height}},z={{this.z}},dx={{this.xend - this.x}},dy={{(this.yend - this.y) + this.death_area_height}},dz={{this.zend - this.z}}]
    @bypass /bossbar set {{id}} players {{player_name}}
    @bypass /bossbar set {{id}} visible true
@done 