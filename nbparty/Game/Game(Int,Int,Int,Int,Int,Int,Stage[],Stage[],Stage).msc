@fast
@var this.x = x
@var this.y = y
@var this.z = z
@var this.xend = xend
@var this.yend = yend
@var this.zend = zend
@var this.stages = stages
@var this.evil_stages = evil_stages
@var this.neutral_stage = neutral_stage

@var this.playableArea = Region(x, y, z, xend, y + 16, zend, "theta")

@var this.players = String[]
@var this.current_stage = nbparty::neutral_stage
@var this.round = 0
@var this.game_active = false
@var this.start_game_check = false
@var this.times_start_pressed = 0

@var this.evil_mode = false
@var this.evil_round = false
