# method Boolean beginCountdown()
# start_game_check default false -> constantly checks if it's true to to continue with countdown & starting game
@var this.start_game_check = !this.start_game_check

@for Int i in list::range(0, 80)
    @if this.start_game_check
        @if i == 0
            @var this.messageAllPlayers("[Not Block Party] Starting Game in:")
        @fi

        @if i == 20
            @var this.playSoundToAllPlayers("minecraft:entity.experience_orb.pickup", "1.0", "1.0")
            @var this.messageAllPlayers("[Not Block Party] 3")
        @fi

        @if i == 40
            @var this.playSoundToAllPlayers("minecraft:entity.experience_orb.pickup", "1.0", "1.0")
            @var this.messageAllPlayers("[Not Block Party] 2")
        @fi

        @if i == 60
            @var this.playSoundToAllPlayers("minecraft:entity.experience_orb.pickup", "1.0", "1.0")
            @var this.messageAllPlayers("[Not Block Party] 1")
        @fi

        @delay 1
    @else 
        @var this.times_start_pressed += 1
        @return false
    @fi
@done

@return true