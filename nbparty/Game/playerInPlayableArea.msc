# Boolean playerInPlayableArea(String player_name)
@fast

@define Player player = Player(player_name)

@if player == null
    @return false
@fi

@return ((player.getX() <= this.xend + 1) && (player.getX() >= this.x) && (player.getY() <= this.yend + 1) && (player.getY() >= (this.y - this.death_area_height)) && (player.getZ() <= this.zend + 1) && (player.getZ() >= this.z))