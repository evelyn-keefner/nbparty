# method playSoundToPlayersOnStage(String message)
@fast
@console /execute in minecraft:theta as @a[x={{this.x}},y={{this.y - this.death_area_height}},z={{this.z}},dx={{this.xend - this.x}},dy={{(this.yend - this.y) + this.death_area_height}},dz={{this.zend - this.z}}] at @s run playsound {{sound}} master @s ~ ~ ~ {{volume}} {{pitch}}