# method checkForWinner()
@fast

# if players
@if this.players.length() == 0
    # if game started with 0 players (dced)
    @if this.to_be_eliminated_players.length() == 0
        @var this.messageAllPlayers("[Not Block Party] Game started with 0 players! Ending...")
        @var this.game_active = false
        @return
    @fi


    @for String eliminated_player in this.to_be_eliminated_players
        @var this.messageAllPlayers("[Not Block Party] {{eliminated_player}} wins. I guess.")

        @if (this.stats_valid)
            @var nbparty::wins[Player(eliminated_player)][this.getIndexFromCurrentMode()] += 1
        @fi
    @done 
    @var this.game_active = false
@fi

@var this.to_be_eliminated_players.clear()