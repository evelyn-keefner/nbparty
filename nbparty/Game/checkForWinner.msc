# method checkForWinner(String player_name)
@fast

@if this.players.length() == 0
    @var this.messageAllPlayers("[Not Block Party] {{player_name}} winsssssssssssssssssssssssss")
    @if (this.persistent_players.length() >= 2)
        @var nbparty::wins[Player(player_name)][this.getIndexFromCurrentMode()] += 1
    @fi
    @var this.game_active = false
@fi